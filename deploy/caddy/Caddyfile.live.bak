####################################
# MYNUTRIAPP
####################################
mynutriapp.cloud {
	encode gzip zstd

	@static path /static/*
	handle @static {
		root * /var/www/mynutriapp/static
		uri strip_prefix /static
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8099
	}

	request_body {
		max_size 100MB
	}
}

www.mynutriapp.cloud {
	redir https://mynutriapp.cloud{uri} permanent
}
####################################
# ALBASHORE
####################################
alba.puttantour.online {
	encode gzip zstd
	reverse_proxy 127.0.0.1:8998
}

####################################
# MYNUTRIAPP STAGING
####################################
stage.mynutriapp.cloud {
	encode gzip zstd

	@static path /static/*
	handle @static {
		root * /var/www/staging-mynutriapp/static
		uri strip_prefix /static
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8199
	}

	request_body {
		max_size 100MB
	}
}
