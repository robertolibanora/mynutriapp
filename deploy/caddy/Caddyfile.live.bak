####################################
# BIKES / RANA AGILE GO
####################################
ranaagilego.com {
	encode gzip zstd
	reverse_proxy 127.0.0.1:9200
}

www.ranaagilego.com {
	redir https://ranaagilego.com{uri} permanent
}

