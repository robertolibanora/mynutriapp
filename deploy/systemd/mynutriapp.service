[Unit]
Description=MyNutriApp - applicazione Flask (Gunicorn)
After=network-online.target mysql.service redis-server.service
Wants=network-online.target
Requires=mysql.service

[Service]
Type=simple
User=noira
Group=noira
WorkingDirectory=/var/www/mynutriapp
EnvironmentFile=/var/www/mynutriapp/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/mynutriapp/venv/bin/gunicorn -c deploy/gunicorn.conf.py wsgi:app
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/var/www/mynutriapp/static/uploads /var/www/mynutriapp/logs /var/www/mynutriapp/storage

[Install]
WantedBy=multi-user.target
