# Base URL del backend Flask (senza trailing slash).
# iOS Simulator / desktop: http://127.0.0.1:5000
# Android Emulator:        http://10.0.2.2:5000
# Dispositivo fisico:      http://<IP-LAN-del-Mac>:5000
API_BASE_URL=http://127.0.0.1:5000

# true = schermate usano repository mock (default in sviluppo)
USE_MOCK_DATA=true
