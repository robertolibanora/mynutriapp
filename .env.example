# ========================================
# 🔐 ADMIN (PRODUZIONE)
# ========================================
ADMIN_PHONE=+39XXXXXXXXXX
ADMIN_NAME=MyNutriApp
ADMIN_PASSWORD_HASH=genera-con-werkzeug

# ========================================
# 🔑 FLASK / SECURITY
# ========================================
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=genera-con-secrets-token-hex-64-chars
ENCRYPTION_KEY=genera-con-fernet

# JWT API mobile (/api/v1). Se JWT_SECRET è vuoto si usa SECRET_KEY.
JWT_SECRET=
JWT_ACCESS_EXPIRES=900
JWT_REFRESH_EXPIRES=2592000

# ========================================
# 🍪 SESSION
# ========================================
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME=7200
SESSION_REFRESH_EACH_REQUEST=True
SESSION_PROTECTION=strong

# ========================================
# 🛡️ CSRF
# ========================================
WTF_CSRF_ENABLED=True
WTF_CSRF_TIME_LIMIT=3600

# ========================================
# 🗄️ DATABASE MYSQL (nativo su VPS)
# ========================================
DB_TRACK_MODIFICATIONS=False
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mynutriapp
DB_USER=mynutriapp
DB_PASSWORD=your-secure-password

MYSQL_ROOT_PASSWORD=your-root-password
MYSQL_PASSWORD=your-secure-password

# ========================================
# 🔴 REDIS (nativo su VPS)
# ========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your-redis-password

# ========================================
# 🚦 RATE LIMITING
# ========================================
RATELIMIT_ENABLED=True
RATELIMIT_STORAGE_URL=redis://:your-redis-password@127.0.0.1:6379/0
RATELIMIT_DEFAULT_PER_DAY=5000
RATELIMIT_DEFAULT_PER_HOUR=200
RATELIMIT_LOGIN_LIMIT="20 per 15 minutes"
RATELIMIT_CREATE_LIMIT="100 per hour"
RATELIMIT_UPLOAD_LIMIT="50 per hour"

# ========================================
# ⚙️ GUNICORN (systemd)
# ========================================
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30

# ========================================
# 📁 UPLOAD
# ========================================
UPLOAD_ROOT=static/uploads
MAX_FILE_SIZE=10

# ========================================
# 🎙️ DIARIO — AUDIO COLLOQUIO
# ========================================
# Path assoluto o relativo alla root del progetto (mai in static/ pubblico)
AUDIO_STORAGE_PATH=storage/audio
# 32 byte in hex (64 caratteri). Genera con: python -c "import secrets; print(secrets.token_hex(32))"
AUDIO_ENCRYPTION_KEY=replace-with-64-hex-chars
AUDIO_MAX_MB=100
AUDIO_MAX_DURATION_SEC=10800
AUDIO_ALLOWED_MIME=audio/mpeg,audio/mp4,audio/webm,audio/ogg,audio/wav

# ========================================
# 🗣️ DIARIO — TRASCRIZIONE
# ========================================
# local_whisper (default, self-hosted) | openai_whisper (API esterna)
TRANSCRIPTION_PROVIDER=local_whisper
TRANSCRIPTION_LANGUAGE=it
TRANSCRIPTION_MAX_ATTEMPTS=3
TRANSCRIPTION_RETRY_BASE_SEC=1
# thread = BackgroundTasks in-process | sync = immediato (test) | celery = futuro
JOB_BACKEND=thread

# faster-whisper (TRANSCRIPTION_PROVIDER=local_whisper)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# WHISPER_DOWNLOAD_ROOT=/var/cache/whisper

# OpenAI Whisper API (solo se TRANSCRIPTION_PROVIDER=openai_whisper)
# e estrazione diario strutturato (sempre richiesta se usi extract)
# OPENAI_API_KEY=sk-...
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_WHISPER_TIMEOUT_SEC=120
# OPENAI_BASE_URL=

# ========================================
# 📓 DIARIO — ESTRAZIONE OPENAI
# ========================================
# Usa OPENAI_API_KEY (vedi sopra). Default: gpt-4o-mini.
OPENAI_DIARY_MODEL=gpt-4o-mini
OPENAI_DIARY_MAX_TOKENS=4096
OPENAI_DIARY_TEMPERATURE=0
# Single-tenant: l'admin autenticato accede a tutti i pazienti (default True)
SINGLE_TENANT=True

# ========================================
# 🧾 AUDIT LOG
# ========================================
AUDIT_LOG_RETENTION_DAYS=730

# ========================================
# 🍎 NUTRIZIONE - PROVIDER ALIMENTI ESTERNO
# ========================================
# Provider attivo per la ricerca alimenti (usda_fdc | openfoodfacts)
NUTRITION_PROVIDER=usda_fdc
NUTRITION_HTTP_TIMEOUT=8
# API key gratuita: https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=your-usda-fdc-api-key
USDA_FDC_BASE_URL=https://api.nal.usda.gov/fdc/v1
USDA_FDC_DATA_TYPES=Foundation,SR Legacy,Survey (FNDDS)
OPENFOODFACTS_BASE_URL=https://it.openfoodfacts.org
OPENFOODFACTS_USER_AGENT=MyNutriApp/1.0 (nutrition module)

# ========================================
# 📱 WHATSAPP - Evolution API (opzionale)
# ========================================
WHATSAPP_ENABLED=False
WHATSAPP_FROM_NAME=MyNutriApp
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE=mynutriapp

# ========================================
# 💳 STRIPE BILLING (opzionale)
# ========================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=price_xxx_starter
STRIPE_PRICE_PROFESSIONAL=price_xxx_professional
STRIPE_PRICE_STUDIO=price_xxx_studio
STRIPE_SUCCESS_URL=https://example.com/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://example.com/landing?checkout=cancel

# ========================================
# 🌐 URL pubblici (link email invito / reset)
# ========================================
# Base URL dell'app (senza slash finale). Usato nei link di invito e reset password.
APP_PUBLIC_URL=https://stage.mynutriapp.cloud
# Opzionale: URL frontend pazienti se diverso da APP_PUBLIC_URL
FRONTEND_URL=

# ========================================
# ✉️ EMAIL SMTP — Hostinger (invito + reset password)
# ========================================
# Pannello Hostinger → Email → Configura client di posta
MAIL_SERVER=smtp.hostinger.com
# 465 + SSL (consigliato) oppure 587 + STARTTLS
MAIL_PORT=465
MAIL_USE_TLS=False
MAIL_USE_SSL=True
MAIL_USERNAME=noreply@tuodominio.it
MAIL_PASSWORD=your-mailbox-password
MAIL_FROM=noreply@tuodominio.it
MAIL_REPLY_TO=
MAIL_TIMEOUT_SEC=20
# Invito primo accesso (default 7 giorni = 10080 minuti)
INVITE_TOKEN_EXPIRES_MINUTES=10080
# Reset password (consigliato 30–60 minuti)
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=45
